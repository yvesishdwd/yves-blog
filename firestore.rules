rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorOnWrite() {
      return (
        (isSignedIn() && request.auth.token.email == 'huyhoang28092007@gmail.com') ||
        (request.resource.data != null && (
          request.resource.data.authorSecret == 'ieatandlovetomato444' ||
          request.resource.data.authorSecret == '28092007'
        ))
      );
    }

    function isAuthorOnDelete() {
      return (
        (isSignedIn() && request.auth.token.email == 'huyhoang28092007@gmail.com') ||
        (resource.data != null && 'authorSecret' in resource.data && (
          resource.data.authorSecret == 'ieatandlovetomato444' ||
          resource.data.authorSecret == '28092007'
        )) ||
        (resource.data != null && 'authorEmail' in resource.data && resource.data.authorEmail == 'huyhoang28092007@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public diary entries
    match /diary_entries/{entryId} {
      allow read: if true;
      allow create: if isAuthorOnWrite() &&
        isValidId(entryId) &&
        request.resource.data.date is string &&
        request.resource.data.text is string;
      allow update: if isAuthorOnWrite();
      allow delete: if isAuthorOnDelete();
    }

    // Public writing articles
    match /writing_articles/{articleId} {
      allow read: if true;
      allow create: if isAuthorOnWrite() &&
        isValidId(articleId) &&
        request.resource.data.title is string;
      allow update: if isAuthorOnWrite();
      allow delete: if isAuthorOnDelete();
    }

    // Recently deleted entries (trash can)
    match /deleted_entries/{entryId} {
      allow read: if true;
      allow create, update: if isAuthorOnWrite();
      allow delete: if true;
    }
  }
}
